# Copy this file to ".env" and fill in your own PayPal sandbox credentials.
# Get these from https://developer.paypal.com/dashboard/ -> Apps & Credentials -> Sandbox.
# These are SANDBOX (test) credentials only. Never put live credentials here.

PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_ENV=sandbox

# Optional: AI-generated warning text. If LLM_PROVIDER=none (default) the app
# uses clear template-based explanations and works fully with no setup.
#
# FREE / local option (recommended, no API key, data stays on your machine):
#   1. install Ollama from https://ollama.com
#   2. run:  ollama pull llama3.2   then   ollama serve
#   3. set LLM_PROVIDER=ollama  below
#
# Or use a hosted model:
#   LLM_PROVIDER=anthropic   + LLM_API_KEY   (from console.anthropic.com)
#   LLM_PROVIDER=openai      + LLM_API_KEY
LLM_PROVIDER=none
LLM_API_KEY=
# LLM_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434
